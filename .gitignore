## ─────────────────────────────────────────────────────────────
## Patchbay-specific
## Connection documents contain real hostnames, addresses and
## encrypted credential blobs. None of it belongs in the repo.
## ─────────────────────────────────────────────────────────────
*.rdg
*.rdp

# ...but not directories that happen to match. Git on Windows runs with
# core.ignorecase=true, so the pattern above otherwise swallows the whole
# src/Patchbay.Rdp/ project. A trailing slash matches directories only.
!*.rdg/
!*.rdp/

connections.json
*.connections.json
patchbay.local.json
/local/
/sandbox/
samples/private/

# Local dev overrides
appsettings.Development.json
appsettings.Local.json
*.local.props
*.local.targets

