<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Clear inherited feeds and use nuget.org alone.

       This machine has private feeds configured globally. Combined with
       central package management that is a supply-chain risk: a package
       name could resolve from a private feed instead of the public one.
       Scoping the repo to a single source removes the ambiguity and the
       NU1507 warning along with it.

       If a private feed is ever needed, add it here *with* a matching
       packageSourceMapping entry — never without one. -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <packageManagement>
    <add key="format" value="1" />
    <add key="disabled" value="False" />
  </packageManagement>

</configuration>
