<Window x:Class="Patchbay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Patchbay.App.Converters"
        xmlns:core="clr-namespace:Patchbay.Core.Sessions;assembly=Patchbay.Core"
        xmlns:sess="clr-namespace:Patchbay.App.Sessions"
        xmlns:vm="clr-namespace:Patchbay.App.ViewModels"
        Title="Patchbay"
        Height="780" Width="1280"
        MinHeight="540" MinWidth="920"
        Background="{DynamicResource BrushWindow}"
        FontFamily="{DynamicResource FontUi}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>

        <!-- A panel is a card on the window ground: same corner radius, same
             hairline border, everywhere. -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!-- Groups are named a shade heavier than the machines inside them,
             which is enough structure at this size without a second colour. -->
        <Style x:Key="TreeNodeName" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <!-- Explicit: a keyed style does not pick up the implicit
                 TextBlock one, so without this the names take whatever
                 foreground the TreeViewItem happens to inherit. -->
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── A tab ──────────────────────────────────────────────────────
             Not a TabItem, and the strip below is not a TabControl. A
             TabControl keeps one content presenter and rebuilds it on every
             switch, which for a hosted session means destroying the window
             the RDP control lives in — and the session with it — each time
             someone glances at another tab. -->
        <Style x:Key="TabChrome" TargetType="Border">
            <Setter Property="CornerRadius" Value="7,7,0,0" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabCloseButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="9,0,-3,0" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <DataTemplate x:Key="SessionTabTemplate" DataType="{x:Type vm:SessionTabViewModel}">
            <!-- Left click activates, middle click closes; both are handled in
                 code-behind, which is the shortest honest way to tell one
                 button from the other. -->
            <Border x:Name="Chrome"
                    Style="{StaticResource TabChrome}"
                    MouseDown="OnSessionTabMouseDown"
                    ToolTip="{Binding Endpoint}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="Dot"
                             Width="7" Height="7"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource BrushTextFaint}" />

                    <TextBlock Text="{Binding Title}"
                               VerticalAlignment="Center"
                               MaxWidth="168"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource SizeSmall}"
                               Foreground="{DynamicResource BrushText}" />

                    <Button Style="{StaticResource TabCloseButton}"
                            Content="✕"
                            ToolTip="Close — or middle-click the tab"
                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BrushSurface}" />
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource BrushWarn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource BrushGood}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasFailed}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource BrushBad}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── What a session shows when there is no picture ───────────────
             Everything a tab has to say lives here rather than over the
             session, because WPF drawn over a hosted window is not visible
             (M4-03). SessionSurface swaps the two. -->
        <DataTemplate x:Key="SessionOverlayTemplate" DataType="{x:Type vm:SessionTabViewModel}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                <TextBlock Style="{StaticResource Subhead}"
                           Text="{Binding Title}"
                           HorizontalAlignment="Center" />

                <TextBlock Style="{StaticResource MonoText}"
                           Text="{Binding Endpoint}"
                           HorizontalAlignment="Center"
                           Margin="0,3,0,2" />

                <TextBlock Style="{StaticResource Caption}"
                           Text="{Binding SizingSummary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />

                <TextBlock Style="{StaticResource Caption}"
                           Text="{Binding StatusMessage}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <!-- The countdown (M4-08), under the failure rather than in
                     place of it: why the session went is the more useful half,
                     and it is what somebody reads first. -->
                <TextBlock Style="{StaticResource Caption}"
                           Text="{Binding ReconnectSummary}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource BrushWarn}"
                           Visibility="{Binding ReconnectSummary, Converter={x:Static conv:ValueConverters.TextToVisibility}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="Connect"
                            Visibility="{Binding CanConnect, Converter={x:Static conv:ValueConverters.BoolToVisibility}}"
                            Command="{Binding DataContext.ReconnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />

                    <Button Style="{StaticResource GhostButton}"
                            Content="Stop reconnecting"
                            Margin="8,0,0,0"
                            Visibility="{Binding IsReconnecting, Converter={x:Static conv:ValueConverters.BoolToVisibility}}"
                            Command="{Binding DataContext.CancelReconnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />

                    <Button Style="{StaticResource GhostButton}"
                            Content="Disconnect"
                            Margin="8,0,0,0"
                            Visibility="{Binding IsLive, Converter={x:Static conv:ValueConverters.BoolToVisibility}}"
                            Command="{Binding DataContext.DisconnectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </StackPanel>

                <!-- A simulated session that looks real is how someone comes to
                     believe they patched a server they never reached. -->
                <TextBlock Style="{StaticResource Caption}"
                           Margin="0,22,0,0"
                           TextAlignment="Center"
                           Foreground="{DynamicResource BrushWarn}"
                           Text="{Binding DataContext.SessionHostDescription, RelativeSource={RelativeSource AncestorType=Window}}"
                           Visibility="{Binding DataContext.IsSimulatedHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:ValueConverters.BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <!-- ── One field in the status bar (M5-17) ────────────────────────
             Label faint, value in the tone Core chose for it. Muted is not
             merely a lighter colour: it means the value is what was
             configured, not what was negotiated, so a resolution or a gateway
             visibly hardens the moment it becomes a fact. -->
        <DataTemplate x:Key="SessionStatusFieldTemplate" DataType="{x:Type core:SessionStatusField}">
            <StackPanel Orientation="Horizontal" Margin="18,0,0,0" ToolTip="{Binding Detail}">
                <TextBlock Text="{Binding Label}"
                           FontSize="{DynamicResource SizeCaption}"
                           Foreground="{DynamicResource BrushTextFaint}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />

                <TextBlock x:Name="Value"
                           Text="{Binding Value}"
                           FontSize="{DynamicResource SizeCaption}"
                           Foreground="{DynamicResource BrushText}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Muted">
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warn">
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource BrushWarn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Bad">
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource BrushBad}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── A row in the tree ──────────────────────────────────────────
             The glyph carries the type, which is the one thing a scanning eye
             needs before the name. The address is right-aligned and set in a
             monospaced face so that a column of them lines up and can be read
             character by character, which is how addresses get read. -->
        <HierarchicalDataTemplate DataType="{x:Type vm:NodeViewModel}" ItemsSource="{Binding Children}">
            <Grid Margin="2,5,10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="16" Height="16" Margin="0,1,9,0" VerticalAlignment="Center">
                    <Path Data="M 1,3.6 A 1.4,1.4 0 0 1 2.4,2.2 L 5.6,2.2 L 7.1,4.2 L 12.6,4.2 A 1.4,1.4 0 0 1 14,5.6 L 14,11.6 A 1.4,1.4 0 0 1 12.6,13 L 2.4,13 A 1.4,1.4 0 0 1 1,11.6 Z"
                          Fill="{DynamicResource BrushTextFaint}"
                          Visibility="{Binding IsGroup, Converter={x:Static conv:ValueConverters.BoolToVisibility}}" />
                    <Path Data="M 1.5,3 L 13.5,3 L 13.5,10.5 L 1.5,10.5 Z M 5.5,10.5 L 5,13 M 9.5,10.5 L 10,13 M 4,13 L 11,13"
                          Stroke="{DynamicResource BrushTextFaint}"
                          StrokeThickness="1.3"
                          StrokeLineJoin="Round"
                          Visibility="{Binding IsServer, Converter={x:Static conv:ValueConverters.BoolToVisibility}}" />
                </Grid>

                <!-- Two lines, not one. A name and an address side by side in
                     a 300-pixel rail means one of them is always truncated,
                     and both are things people match on exactly. -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TreeNodeName}" Text="{Binding Name}" />
                        <ItemsControl ItemsSource="{Binding Tags}" Margin="8,0,0,0" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}" Margin="0,0,4,0">
                                        <TextBlock Style="{StaticResource ChipLabel}" Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Style="{StaticResource MonoText}"
                               Text="{Binding Summary}"
                               Margin="0,1,0,0"
                               ToolTip="{Binding Summary}"
                               Visibility="{Binding IsServer, Converter={x:Static conv:ValueConverters.BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="{Binding Summary}"
                               Margin="0,1,0,0"
                               Visibility="{Binding IsGroup, Converter={x:Static conv:ValueConverters.BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>

        <!-- ── A resolved setting in the read view ────────────────────────
             The chip is the point of the row. It is left off entirely when
             the value came from a built-in default, because "Default" on
             fourteen rows is noise that hides the two that were inherited. -->
        <DataTemplate DataType="{x:Type vm:DetailRow}">
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Label}"
                           Foreground="{DynamicResource BrushTextMuted}"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" />

                    <Border Style="{StaticResource ChipAccent}"
                            Margin="9,0,0,0"
                            Visibility="{Binding IsOverride, Converter={x:Static conv:ValueConverters.BoolToVisibility}}">
                        <TextBlock Style="{StaticResource ChipLabelAccent}" Text="Set here" />
                    </Border>

                    <Border Style="{StaticResource Chip}"
                            Margin="9,0,0,0"
                            Visibility="{Binding IsInherited, Converter={x:Static conv:ValueConverters.BoolToVisibility}}">
                        <TextBlock Style="{StaticResource ChipLabel}" Text="{Binding Origin, StringFormat=from {0}}" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DetailSection}">
            <StackPanel Margin="0,22,0,0">
                <TextBlock Style="{StaticResource SectionHeading}" Text="{Binding Title}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Rows}" />
            </StackPanel>
        </DataTemplate>

        <!-- ── An editable setting ────────────────────────────────────────
             Two states in one template: overridden shows a control, inherited
             shows the value it would take and where it comes from. Switching
             the checkbox moves between them without losing the value. -->
        <DataTemplate DataType="{x:Type vm:SettingFieldViewModel}">
            <StackPanel Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1"
                              Margin="10,0,0,5"
                              IsChecked="{Binding IsOverridden, Mode=TwoWay}"
                              ToolTip="Set this here instead of inheriting it">
                        <TextBlock Style="{StaticResource ChipLabel}" Text="Override" />
                    </CheckBox>
                </Grid>

                <Grid Visibility="{Binding IsOverridden, Converter={x:Static conv:ValueConverters.BoolToVisibility}}">
                    <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsText, Converter={x:Static conv:ValueConverters.BoolToVisibility}}" />
                    <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{DynamicResource FontMono}"
                             Visibility="{Binding IsNumber, Converter={x:Static conv:ValueConverters.BoolToVisibility}}" />
                    <CheckBox Content="Enabled"
                              Height="30"
                              IsChecked="{Binding BoolValue, Mode=TwoWay}"
                              Visibility="{Binding IsBoolean, Converter={x:Static conv:ValueConverters.BoolToVisibility}}" />
                    <ComboBox ItemsSource="{Binding Choices}"
                              SelectedItem="{Binding ChoiceValue, Mode=TwoWay}"
                              Visibility="{Binding IsChoice, Converter={x:Static conv:ValueConverters.BoolToVisibility}}" />
                </Grid>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsOverridden, Converter={x:Static conv:ValueConverters.NotBoolToVisibility}}">
                    <TextBlock Text="{Binding InheritedText}" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Chip}" Margin="9,0,0,0">
                        <TextBlock Style="{StaticResource ChipLabel}" Text="{Binding InheritedFrom, StringFormat=from {0}}" />
                    </Border>
                </StackPanel>

                <TextBlock Style="{StaticResource Caption}"
                           Text="{Binding Hint}"
                           Margin="0,5,0,0"
                           Visibility="{Binding Hint, Converter={x:Static conv:ValueConverters.TextToVisibility}}" />
                <TextBlock Style="{StaticResource ErrorText}"
                           Text="{Binding Error}"
                           Visibility="{Binding Error, Converter={x:Static conv:ValueConverters.TextToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingSectionViewModel}">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Style="{StaticResource SectionHeading}" Text="{Binding Title}" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding Fields}" />
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewConnectionCommand}" />
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding NewGroupCommand}" />
    </Window.InputBindings>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────── -->
        <Grid Height="60" Margin="18,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource BrushAccent}">
                    <Canvas Width="24" Height="24">
                        <!-- Two jacks and a patch lead. It is a patchbay. -->
                        <Ellipse Canvas.Left="6" Canvas.Top="7" Width="4.5" Height="4.5"
                                 Fill="{DynamicResource BrushTextOnAccent}" />
                        <Ellipse Canvas.Left="13.5" Canvas.Top="12.5" Width="4.5" Height="4.5"
                                 Fill="{DynamicResource BrushTextOnAccent}" />
                        <Path Data="M 8.25,9.25 C 8.25,15 15.75,10 15.75,14.75"
                              Stroke="{DynamicResource BrushTextOnAccent}"
                              StrokeThickness="1.4" />
                    </Canvas>
                </Border>
                <TextBlock Style="{StaticResource Subhead}" Text="Patchbay" Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding FileName}" Margin="10,2,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}"
                        Content="{Binding ThemeLabel}"
                        Command="{Binding ToggleThemeCommand}" />
                <Button Style="{StaticResource GhostButton}"
                        Content="Import .rdg"
                        Margin="4,0,0,0"
                        ToolTip="Import a Remote Desktop Connection Manager file"
                        Command="{Binding ImportRdgCommand}" />
                <Button Content="New group" Margin="8,0,0,0" Command="{Binding NewGroupCommand}" />
                <Button Style="{StaticResource PrimaryButton}"
                        Content="New connection"
                        Margin="8,0,0,0"
                        Command="{Binding NewConnectionCommand}" />
            </StackPanel>
        </Grid>

        <!-- ── Notice ─────────────────────────────────────────────────────
             Recovery from a backup, a schema upgrade, a failed save. Never a
             transient toast: these are things someone has to actually read. -->
        <Border Grid.Row="1"
                Margin="18,0,18,12"
                Padding="14,10"
                CornerRadius="8"
                Background="{DynamicResource BrushAccentSoft}"
                BorderBrush="{DynamicResource BrushAccentBorder}"
                BorderThickness="1"
                Visibility="{Binding Notice, Converter={x:Static conv:ValueConverters.TextToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Content="✕"
                        Margin="12,0,0,0"
                        Command="{Binding DismissNoticeCommand}" />
            </Grid>
        </Border>

        <!-- ── Body ───────────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="316" MinWidth="240" MaxWidth="560" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Tree -->
            <Border Style="{StaticResource Panel}" Margin="18,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="12,12,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Tag="Search name, address or tag"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="9,0,30,0" />
                            <Button Style="{StaticResource IconButton}"
                                    Content="✕"
                                    Width="26" Height="26"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,2,0"
                                    Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding IsSearching, Converter={x:Static conv:ValueConverters.BoolToVisibility}}" />
                        </Grid>

                        <!-- Drawn rather than typed. The chevron characters
                             that look right in a browser fall back to
                             something heavier in the Windows UI face. -->
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                Margin="6,0,0,0"
                                ToolTip="Expand everything"
                                Command="{Binding ExpandAllCommand}">
                            <Path Data="M 0,0 L 4.5,4.5 L 9,0"
                                  Stroke="{DynamicResource BrushTextMuted}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                ToolTip="Collapse everything"
                                Command="{Binding CollapseAllCommand}">
                            <Path Data="M 0,4.5 L 4.5,0 L 9,4.5"
                                  Stroke="{DynamicResource BrushTextMuted}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <TreeView x:Name="Tree"
                                  ItemsSource="{Binding Roots}"
                                  SelectedItemChanged="OnTreeSelectionChanged"
                                  PreviewMouseRightButtonDown="OnTreeRightButtonDown"
                                  MouseDoubleClick="OnTreeDoubleClick"
                                  Margin="0,0,0,8">
                            <TreeView.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ConnectSelectedCommand}" />
                                <KeyBinding Key="Delete" Command="{Binding RequestDeleteCommand}" />
                                <KeyBinding Key="F2" Command="{Binding EditSelectedCommand}" />
                            </TreeView.InputBindings>
                            <TreeView.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Connect" InputGestureText="Enter" Command="{Binding ConnectSelectedCommand}" />
                                    <Separator />
                                    <MenuItem Header="Edit" InputGestureText="F2" Command="{Binding EditSelectedCommand}" />
                                    <MenuItem Header="Duplicate" Command="{Binding DuplicateSelectedCommand}" />
                                    <Separator />
                                    <MenuItem Header="New connection here" InputGestureText="Ctrl+N" Command="{Binding NewConnectionCommand}" />
                                    <MenuItem Header="New group here" InputGestureText="Ctrl+Shift+N" Command="{Binding NewGroupCommand}" />
                                    <Separator />
                                    <MenuItem Header="Delete" InputGestureText="Del" Command="{Binding RequestDeleteCommand}" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>

                        <TextBlock Style="{StaticResource Caption}"
                                   Text="{Binding SearchText, StringFormat=Nothing matches “{0}”.}"
                                   HorizontalAlignment="Center"
                                   Margin="24,64,24,0"
                                   TextAlignment="Center"
                                   Visibility="{Binding HasSearchResults, Converter={x:Static conv:ValueConverters.NotBoolToVisibility}}" />
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          Background="Transparent"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />

            <!-- ── Workspace ──────────────────────────────────────────────
                 The connections view and the sessions, never both. A hosted
                 session draws in front of any WPF content in the same window,
                 so the two swap rather than stack (M4-03). -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Tab strip. Hidden until there is something in it: one lone
                     tab labelled Connections is a row of chrome that says
                     nothing. -->
                <Grid Visibility="{Binding HasTabs, Converter={x:Static conv:ValueConverters.BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,0,0,-1">
                    <StackPanel Orientation="Horizontal">
                        <!-- The permanent one. There is always somewhere to go
                             back to, so closing the last session never leaves
                             an empty window. -->
                        <Border MouseDown="OnConnectionsTabMouseDown">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource TabChrome}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBrowsing}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <TextBlock Text="Connections"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource SizeSmall}"
                                       Foreground="{DynamicResource BrushText}" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding Tabs}"
                                      ItemTemplate="{StaticResource SessionTabTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                    <!-- Smart sizing (M5-09). Beside the session and not over
                         it, because WPF drawn over a hosted session is not
                         visible; and a button rather than a shortcut, because
                         a live session takes the keyboard (M5-06, M5-07).
                         mstsc puts the same toggle in its system menu. -->
                    <Button Grid.Column="1"
                            Style="{StaticResource GhostButton}"
                            Height="26"
                            Margin="10,0,2,3"
                            VerticalAlignment="Bottom"
                            FontSize="{DynamicResource SizeSmall}"
                            Content="{Binding ActiveTab.SizingLabel}"
                            ToolTip="Scale the remote desktop to fit this tab, or show it pixel for pixel and scroll"
                            Command="{Binding ToggleSmartSizingCommand}"
                            Visibility="{Binding IsSessionVisible, Converter={x:Static conv:ValueConverters.BoolToVisibility}}" />
                </Grid>

            <!-- Detail -->
            <Border Grid.Row="1"
                    Style="{StaticResource Panel}"
                    Visibility="{Binding IsBrowsing, Converter={x:Static conv:ValueConverters.BoolToVisibility}}">
                <Grid>
                    <!-- Nothing selected, or nothing to select. -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="360"
                                Visibility="{Binding SelectedNode, Converter={x:Static conv:ValueConverters.AbsentToVisibility}}">
                        <TextBlock Style="{StaticResource Subhead}" Text="Nothing selected" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Pick a connection on the left to see how its settings resolve, or start a new one."
                                   TextAlignment="Center"
                                   Margin="0,8,0,16" />
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="New connection"
                                HorizontalAlignment="Center"
                                Command="{Binding NewConnectionCommand}" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedNode, Converter={x:Static conv:ValueConverters.PresentToVisibility}}">
                        <!-- Held to a readable measure rather than filling the
                             pane. On a wide monitor a settings list stretched
                             to 1400 pixels puts the label and its value at
                             opposite ends of the desk. -->
                        <StackPanel Margin="26,24,26,32" MaxWidth="720" HorizontalAlignment="Left">
                            <!-- First run. The root's settings are still below
                                 and still editable — they are the document's
                                 defaults, and worth setting before there is
                                 anything to inherit them. -->
                            <Border Padding="18,16"
                                    Margin="0,0,0,22"
                                    CornerRadius="8"
                                    Background="{DynamicResource BrushAccentSoft}"
                                    BorderBrush="{DynamicResource BrushAccentBorder}"
                                    BorderThickness="1"
                                    Visibility="{Binding IsEmpty, Converter={x:Static conv:ValueConverters.BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Subhead}" Text="Nothing here yet" />
                                    <TextBlock Style="{StaticResource Caption}"
                                               Text="Add a connection, or make a group first and let everything inside it share the same gateway and credentials."
                                               Margin="0,6,0,14" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Content="New connection"
                                                Command="{Binding NewConnectionCommand}" />
                                        <Button Content="New group" Margin="8,0,0,0" Command="{Binding NewGroupCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Caption}" Text="{Binding SelectedNode.DisplayPath}" />
                            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding SelectedNode.Name}" Margin="0,2,0,0" />
                            <TextBlock Style="{StaticResource MonoText}"
                                       FontSize="{DynamicResource SizeBody}"
                                       Text="{Binding SelectedNode.HostName}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding SelectedNode.HostName, Converter={x:Static conv:ValueConverters.TextToVisibility}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="Edit" Command="{Binding EditSelectedCommand}" />
                                <Button Content="Duplicate" Margin="8,0,0,0" Command="{Binding DuplicateSelectedCommand}" />
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Delete"
                                        Margin="8,0,0,0"
                                        Foreground="{DynamicResource BrushBad}"
                                        Command="{Binding RequestDeleteCommand}" />
                            </StackPanel>

                            <!-- Inline confirm rather than a message box: this
                                 has to keep working once a live session is
                                 painting over the window. -->
                            <Border Margin="0,14,0,0"
                                    Padding="14,12"
                                    CornerRadius="8"
                                    Background="{DynamicResource BrushBadSoft}"
                                    BorderBrush="{DynamicResource BrushBadBorder}"
                                    BorderThickness="1"
                                    Visibility="{Binding IsDeleteRequested, Converter={x:Static conv:ValueConverters.BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DeleteWarning}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Style="{StaticResource DangerButton}"
                                                Content="Delete"
                                                Command="{Binding ConfirmDeleteCommand}" />
                                        <Button Style="{StaticResource GhostButton}"
                                                Content="Keep it"
                                                Margin="8,0,0,0"
                                                Command="{Binding CancelDeleteCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,18,0,0"
                                    Padding="14,12"
                                    CornerRadius="8"
                                    Background="{DynamicResource BrushSurfaceRaised}"
                                    Visibility="{Binding SelectedNode.Notes, Converter={x:Static conv:ValueConverters.TextToVisibility}}">
                                <TextBlock Text="{Binding SelectedNode.Notes}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding DetailSections}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Sessions. Every open one stays in the tree and only the active
                 one is visible: taking a session out of the visual tree to
                 show another would destroy its window, and the session with
                 it. -->
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding Tabs}"
                          Visibility="{Binding IsSessionVisible, Converter={x:Static conv:ValueConverters.BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SessionTabViewModel}">
                        <Border Style="{StaticResource Panel}"
                                Visibility="{Binding IsActive, Converter={x:Static conv:ValueConverters.BoolToVisibility}}">
                            <!-- The session goes in, and the overlay takes its
                                 place whenever there is not a live picture to
                                 show. Never both (M4-03). -->
                            <sess:SessionSurface Overlay="{Binding}"
                                                 OverlayTemplate="{StaticResource SessionOverlayTemplate}"
                                                 Session="{Binding Session}"
                                                 IsOverlayVisible="{Binding IsLive, Converter={x:Static conv:ValueConverters.NotBool}}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Grid>

            <!-- Editor -->
            <Border Grid.Column="3"
                    Style="{StaticResource Panel}"
                    Width="404"
                    Margin="12,0,18,0"
                    Visibility="{Binding IsEditing, Converter={x:Static conv:ValueConverters.BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="22,20,22,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Subhead}" Text="{Binding Editor.Title}" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="{Binding Editor.ParentPath, StringFormat=in {0}}"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding Editor.ParentPath, Converter={x:Static conv:ValueConverters.TextToVisibility}}" />
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}"
                                Content="✕"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Command="{Binding CancelEditorCommand}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                        <StackPanel Margin="22,0,22,24">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Name" />
                            <TextBox Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Something you will recognise" />
                            <TextBlock Style="{StaticResource ErrorText}"
                                       Text="{Binding Editor.NameError}"
                                       Visibility="{Binding Editor.NameError, Converter={x:Static conv:ValueConverters.TextToVisibility}}" />

                            <StackPanel Margin="0,15,0,0"
                                        Visibility="{Binding Editor.IsServer, Converter={x:Static conv:ValueConverters.BoolToVisibility}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Host name or address" />
                                <TextBox Text="{Binding Editor.HostName, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{DynamicResource FontMono}"
                                         Tag="web-prd-01.corp.local" />
                                <TextBlock Style="{StaticResource ErrorText}"
                                           Text="{Binding Editor.HostNameError}"
                                           Visibility="{Binding Editor.HostNameError, Converter={x:Static conv:ValueConverters.TextToVisibility}}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Tags" Margin="0,15,0,5" />
                                <TextBox Text="{Binding Editor.Tags, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Comma separated" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Notes" Margin="0,15,0,5" />
                            <TextBox Style="{StaticResource MultilineTextBox}"
                                     Text="{Binding Editor.Notes, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Anything worth remembering about this machine" />

                            <ItemsControl ItemsSource="{Binding Editor.Sections}" Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="22,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ErrorText}"
                                       Margin="0,0,0,10"
                                       Text="{Binding Editor.GeneralError}"
                                       Visibility="{Binding Editor.GeneralError, Converter={x:Static conv:ValueConverters.TextToVisibility}}" />

                            <!-- The unsaved-changes guard. It replaces the
                                 buttons rather than sitting above them, so
                                 there is no way to answer it by ignoring it. -->
                            <StackPanel Visibility="{Binding Editor.IsDiscardPromptVisible, Converter={x:Static conv:ValueConverters.BoolToVisibility}}">
                                <TextBlock Text="Throw away the changes you have made here?" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource DangerButton}"
                                            Content="Discard"
                                            Command="{Binding DiscardChangesCommand}" />
                                    <Button Content="Keep editing" Margin="8,0,0,0" Command="{Binding KeepEditingCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Visibility="{Binding Editor.IsDiscardPromptVisible, Converter={x:Static conv:ValueConverters.NotBoolToVisibility}}">
                                <Button Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelEditorCommand}" />
                                <Button Style="{StaticResource PrimaryButton}"
                                        Content="Save"
                                        Margin="8,0,0,0"
                                        Command="{Binding SaveEditorCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Status ───────────────────────────────────────────────────
             The left half is what just happened. The right half belongs to
             whatever is on screen: the file being edited while browsing, and
             the session while one is up (M5-17). Both at once would put the
             path to a file nobody is looking at beside the security layer of
             a live connection, and the second is the one worth the width. -->
        <Grid Grid.Row="3" Height="28" Margin="20,0,20,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource Caption}"
                       Text="{Binding Status}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,12,0" />

            <TextBlock Grid.Column="1"
                       Style="{StaticResource MonoText}"
                       FontSize="{DynamicResource SizeCaption}"
                       Text="{Binding FilePath}"
                       VerticalAlignment="Center"
                       MaxWidth="560"
                       ToolTip="{Binding FilePath}"
                       Visibility="{Binding IsBrowsing, Converter={x:Static conv:ValueConverters.BoolToVisibility}}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsSessionVisible, Converter={x:Static conv:ValueConverters.BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding ActiveTab.StatusFields}"
                              ItemTemplate="{StaticResource SessionStatusFieldTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- The same warning the overlay carries, kept beside the
                     readings themselves: five plausible-looking facts about a
                     session that connected to nothing is exactly how someone
                     comes to believe they patched a server they never reached. -->
                <TextBlock Text="Simulated"
                           FontSize="{DynamicResource SizeCaption}"
                           Foreground="{DynamicResource BrushWarn}"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"
                           ToolTip="{Binding SessionHostDescription}"
                           Visibility="{Binding IsSimulatedHost, Converter={x:Static conv:ValueConverters.BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
