<Project Sdk="Microsoft.NET.Sdk">

  <!-- Domain model, inheritance resolution, storage and importers.
       Deliberately platform-neutral: no WPF, no COM, no Windows APIs.
       CA1416 enforces this, and it is what keeps a non-Windows shell
       (M8-19) possible later. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Patchbay.Core</RootNamespace>
  </PropertyGroup>

  <!-- Serilog, and no sink. Core owns the redaction policy (M3-08) because
       the tests can only see Core, and a security control nothing can test
       is a comment. Where the log is written is Patchbay.App's problem. -->
  <ItemGroup>
    <PackageReference Include="Serilog" />
  </ItemGroup>

</Project>
